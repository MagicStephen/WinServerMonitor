{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MonitorDb": "Host=localhost;Port=5432;Database=winservermonitor;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "WindowsAuthentication": false,
    "RequiredRole": ""
  },
  "WinServerMonitor": {
    "MaxConcurrentRuns": 4,
    "SchedulerIntervalSeconds": 5,
    "MetricsIntervalSeconds": 2,
    "MetricsHistoryMinutes": 15,
    "TopProcessCount": 10,
    "RunRetentionDays": 30,
    "SeedDemoTasks": true,
    "Connections": {
      "Main": {
        "Provider": "PostgreSql",
        "ConnectionString": "Host=localhost;Port=5432;Database=winservermonitor;Username=postgres;Password=postgres"
      }
    }
  }
}
